extends SceneTree
## t_data.gd의 마녀·마법·장비 표를 마크다운으로 찍는다 — 문서(witches_12.md·combat_proto.md)가 코드와 어긋나지 않게.
##   cd game && godot --headless --script ../tools/test/dump_skills.gd > /tmp/skills.md

var _done := false


func _process(_d: float) -> bool:
	if _done:
		return true
	_done = true
	print("<!-- GENERATED by tools/test/dump_skills.gd — t_data.gd와 같다. 고칠 땐 t_data.gd를 고치고 다시 찍는다 -->")
	print("### 능력치\n")
	print("| 마녀 | 속성 | 역할 | 공격력 | 체력 | 속도 | 방어율 | 기본 공격 | 기본 장착 %d개 |" % TData.EQUIP_MAX)
	print("|---|---|---|---|---|---|---|---|---|")
	for wid in TData.ROSTER:
		var w: Dictionary = TData.WITCHES[wid]
		var defs: Array = []
		for sid in w.default:
			defs.append(String(TData.SKILLS[sid].name))
		print("| %s | %s%s | %s | %s | %s | %d | %d%% | %s %s | %s |" % [w.name, TData.ELEMENT_NAME.get(w.element, w.element), "(특수)" if bool(w.special) else "", TData.ROLE_NAME.get(w.get("role", ""), ""),
			TData.fmt(int(w.atk)), TData.fmt(int(w.hp)), int(w.speed), int(round(float(w.def) * 100.0)), String(w.basic.name), String(w.basic.desc).get_slice(". ", 0), " · ".join(defs)])
	print("")
	for wid in TData.ROSTER:
		var w: Dictionary = TData.WITCHES[wid]
		var n := {"attack": 0, "support": 0, "debuff": 0}
		for sid in w.skills:
			n[TData.SKILLS[sid].kind] = int(n[TData.SKILLS[sid].kind]) + 1
		print("### %s — %s (%s) · 공격 %d · 보조 %d · 디버프 %d\n" % [w.name, w.title, TData.ELEMENT_NAME.get(w.element, w.element), n.attack, n.support, n.debuff])
		print("| 마법 | 비용 | 종류 | 대상 | 배율 | 턴당 | 효과 | 참고 구조 |")
		print("|---|---|---|---|---|---|---|---|")
		var ids: Array = (w.skills as Array).duplicate()
		if String(w.get("ultimate", "")) != "":
			ids.append(String(w.ultimate))
		for sid in ids:
			var s: Dictionary = TData.SKILLS[sid]
			var kind: String = {"attack": "공격", "support": "보조", "debuff": "디버프"}.get(String(s.kind), "")
			var tgt: String = {"enemy": "적 1", "enemies": "적 전체", "ally": "아군 1", "ally_any": "아군 1(쓰러진 아군 가능)", "allies": "아군 전체", "self": "자신"}.get(String(s.target), "")
			var mult := ("%.1f" % float(s.mult)) if s.has("mult") else "—"
			var star := "**" if (w.default as Array).has(sid) else ""
			var nm := ("대마법 · " + String(s.name)) if bool(s.get("ultimate", false)) else String(s.name)
			print("| %s%s%s | %d | %s | %s | %s | %s | %s | %s |" % [star, nm, star, int(s.cost), kind, tgt, mult, _per_turn(s), s.desc, s.get("ref", "")])
		if w.has("passive"):
			print("\n패시브 **%s** — %s" % [w.passive.name, w.passive.desc])
		print("")
	print("### 장비 (캐릭터당 1개 · 한 장비는 파티에 한 명만 · 강화 Lv1~3)\n")
	print("| 장비 | Lv1 | Lv2 | Lv3 |")
	print("|---|---|---|---|")
	for eid in TData.EQUIP_ORDER:
		if eid == "":
			continue
		print("| %s | %s | %s | %s |" % [TData.EQUIPS[eid].name, TData.equip_at(eid, 1).desc, TData.equip_at(eid, 2).desc, TData.equip_at(eid, 3).desc])
	return true


## 턴당 배율 (combat_proto.md §15.3): 이 마법을 끊임없이 쓰면 쓰는 차례 비율 f = 2/(비용+1), 턴당 = f × 배율 + (1 − f) × 1.0 (기본 공격).
## 크리 확정은 배율 × 1.4 (R2). 공격 마법만, 광역은 적 1체 기준. 터뜨리기·환급·조건 효과는 넣지 않는다
static func _per_turn(s: Dictionary) -> String:
	if String(s.get("kind", "")) != "attack" or not s.has("mult"):
		return "—"
	var m := float(s.mult)
	for e in s.get("effects", []):
		if String(e.t) == "sure_crit":
			m *= 1.4
	var c := float(int(s.cost))
	var f := minf(2.0 / (c + 1.0), 1.0)
	return "%.2f" % (f * m + (1.0 - f) * 1.0)
